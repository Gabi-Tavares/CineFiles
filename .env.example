# Copie este arquivo para .env.local e preencha somente uma das opções.
# Opção recomendada pela documentação da TMDB:
EXPO_PUBLIC_TMDB_ACCESS_TOKEN=

# Alternativa: chave da API v3.
EXPO_PUBLIC_TMDB_API_KEY=

# Opcional: Firebase (login real e listas na nuvem). Sem estes valores, o app
# usa o login local e guarda as listas só no aparelho.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
